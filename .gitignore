# Xcode（工程由 XcodeGen 从 project.yml 生成，不入库，见 ADR-008）
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.xcarchive
*.ipa
*.dSYM.zip

# SwiftPM
.build/
.swiftpm/

# 本地编译的 vendored 产物（见 docs/03 §6）
Packages/AetherKit/Binaries/

# 本地标识符与签名覆盖（见 docs/03 §3.1）
Config/Local.xcconfig

# 系统与编辑器
.DS_Store
*.swp
.idea/
.vscode/

# 由 Scripts/write-ci-xcconfig.sh 在 CI 中生成
Config/CI.xcconfig

# 由 XcodeGen 根据 project.yml 生成（修改请改 project.yml）
App/Info.plist
App/Aether.entitlements
Tunnel/Info.plist
Tunnel/AetherTunnel.entitlements
Widget/Info.plist
Widget/AetherWidget.entitlements
